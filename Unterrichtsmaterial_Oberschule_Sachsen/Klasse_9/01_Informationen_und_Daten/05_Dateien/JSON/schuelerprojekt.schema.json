{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/schuelerprojekt.schema.json",
  "title": "Schülerprojekt",
  "type": "object",
  "required": [
    "projekt_id",
    "titel",
    "team",
    "klasse",
    "thema",
    "status",
    "fortschritt_prozent",
    "abgabe"
  ],
  "properties": {
    "projekt_id": {
      "type": "string",
      "pattern": "^P-[0-9]{3}$"
    },
    "titel": {
      "type": "string",
      "minLength": 3
    },
    "team": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "klasse": {
      "type": "string",
      "pattern": "^9[a-c]$"
    },
    "thema": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "geplant",
        "in Arbeit",
        "abgeschlossen"
      ]
    },
    "fortschritt_prozent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "abgabe": {
      "type": "string",
      "format": "date"
    },
    "bewertung": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 15
    }
  },
  "additionalProperties": false
}