#!/usr/bin/env bash

set -euo pipefail

ROOT="Unterrichtsmaterial_Oberschule_Sachsen"

echo "Erstelle Projektstruktur ..."

MODULE=(
    "01_Digitale_Welt_und_Daten"
    "02_Tabellenkalkulation"
    "03_Datenbanken"
    "04_Scratch"
    "05_Robot_Karol"
    "06_Programmierung"
    "07_Projektarbeit"
    "08_Lernkontrollen"
)

UNTERORDNER=(
    "Lehrerheft"
    "Schuelerheft"
    "Arbeitsblaetter"
    "Loesungen"
    "Praesentationen"
    "Hausaufgaben"
    "Dateien"
    "Bilder"
    "Quellen"
)

for KLASSE in 7 8 9 10; do
    BASE="${ROOT}/Klasse_${KLASSE}"

    mkdir -p "${BASE}/00_Organisation"

    for MODUL in "${MODULE[@]}"; do
        for ORDNER in "${UNTERORDNER[@]}"; do
            mkdir -p "${BASE}/${MODUL}/${ORDNER}"
        done
    done
done

echo
echo "=========================================="
echo "Projektstruktur erfolgreich erstellt."
echo "Hauptordner: ${ROOT}"
echo "=========================================="